<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <section id="catalog_sorting">
            <group id="wished" translate="label" type="text" sortOrder="120"
                   showInDefault="1" showInWebsite="1" showInStore="1">
                <label>Now in Wishlists</label>
                <field id="enabled" translate="label comment" type="select" sortOrder="10"
                       showInDefault="1" showInWebsite="1" showInStore="1">
                    <label>Enabled</label>
                    <comment>Offers "Now in Wishlists" in Sort By: the products that sit in the most wishlists first. The counts are recomputed by the daily popularity data refresh.</comment>
                    <source_model>Magento\Config\Model\Config\Source\Yesno</source_model>
                </field>
                <field id="period" translate="label comment" type="text" sortOrder="20" showInDefault="1">
                    <label>Period, Days</label>
                    <comment>Days of wishlist additions counted, back from the refresh. 0 counts all additions.</comment>
                    <validate>validate-digits</validate>
                </field>
            </group>
        </section>
    </system>
</config>
